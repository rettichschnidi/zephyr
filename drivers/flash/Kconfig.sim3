config SOC_FLASH_SIM3
	bool "Silicon Labs Sim3 flash driver"
	depends on FLASH && SOC_FAMILY_SIM3
	select FLASH_HAS_DRIVER_ENABLED
	select FLASH_PAGE_LAYOUT
	select FLASH_HAS_PAGE_LAYOUT
	help
	  Enable Silicon Labs Sim3 series internal flash driver.
